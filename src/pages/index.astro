---
import Base from '../layouts/Base.astro';
import ListingGrid from '../components/ListingGrid.astro';
import TikTokRow from '../components/TikTokRow.astro';
import LeadForm from '../components/LeadForm.astro';
import Photo from '../components/Photo.astro';
import Tools from '../components/Tools.astro';
import { AREAS, SITE, STATS, STATS_NOTE, STATS_SOURCE, GUIDES, REVIEWS, DRIVE, PHOTOS, PHOTO_SET, HERO_PHOTO, photoCredit } from '../data/site';
const stat = (label: string) => STATS.find(([, k]) => k === label)?.[0];
const chips = ['U.S. Air Force veteran', `${stat('Homes sold')} homes sold`, `${stat('Total sales volume')} in sales`, 'Based in Goldsboro'];
---
<Base title="The Brady Group | Goldsboro, NC Real Estate" description="Devin Brady, REALTOR® and U.S. Air Force veteran, helps buyers, sellers and military families in Goldsboro, Wayne County, Seymour Johnson AFB and the Triangle.">
  <section class="hero hero-home on-photo">
    <Photo src={HERO_PHOTO.src} eager position="center 35%" />
    <div class="wrap hero-grid">
      <div class="hero-panel">
        <p class="eyebrow">Devin Brady · REALTOR® · U.S. Air Force veteran</p>
        <h1>Find your place in Goldsboro.</h1>
        <p class="hero-sub">Buying, selling or on orders to Seymour Johnson, get straight answers from someone who’s been there.</p>
        <div class="btn-row">
          <a class="btn" href={SITE.smsHref}>Text or call Devin</a>
          <a class="btn btn-outline" href="#tools">Plan your PCS move</a>
        </div>
      </div>
      <a class="tt-card" href={SITE.tiktokProfile} target="_blank" rel="noopener" aria-label="Watch Devin on TikTok (@ncrealtordev)">
        <Photo src={PHOTOS.headshot} alt="" sizes="220px" position="center 18%" />
        <span class="tt-play" aria-hidden="true">▶</span>
        <span class="tt-txt">Watch Devin on TikTok<small>@ncrealtordev ↗</small></span>
      </a>
    </div>
    <p class="photo-credit">{HERO_PHOTO.subject}. <a href={HERO_PHOTO.url} target="_blank" rel="noopener license">{photoCredit(HERO_PHOTO)}</a></p>
  </section>

  <Tools />

  <section class="photo-split meet">
    <div class="photo"><Photo src={PHOTOS.headshot} alt="Devin Brady" sizes="(max-width: 900px) 100vw, 45vw" position="center 20%" /></div>
    <div class="text">
      <p class="eyebrow">Meet Devin</p>
      <h2 class="h2">Hi, I’m Devin. I’ve been on orders too.</h2>
      <p class="body">I help military families, first-time buyers and sellers across Wayne County and the Triangle. You’ll get straight answers, local knowledge and a plan that fits your timeline.</p>
      <p class="body">Every home is priced with care, presented properly and negotiated with discipline. You’ll always know where things stand.</p>
      <ul class="pills">{chips.map((c) => <li>{c}</li>)}</ul>
      <div class="btn-row"><a class="btn" href={SITE.smsHref}>Text Devin</a><a class="btn btn-outline" href="/about/">About The Brady Group</a></div>
    </div>
  </section>

  <section class="wrap section rule-top">
    <div class="head-row">
      <div class="stack" style="gap:14px"><p class="eyebrow">Listings &amp; recent sales</p><h2 class="h2">Devin’s homes</h2></div>
      <a class="link" href="/listings/">All listings →</a>
    </div>
    <ListingGrid featured fill limit={3} />
    <p class="fine-print"><a href={STATS_SOURCE} target="_blank" rel="noopener">{STATS_NOTE} ↗</a></p>
  </section>

  <section class="wrap section rule-top" id="communities">
    <div class="head-row">
      <div class="stack" style="gap:14px"><p class="eyebrow">Where you’ll live</p><h2 class="h2">Communities near the base</h2></div>
      <p class="body" style="max-width:460px">Each area with its typical drive to Seymour Johnson AFB, so you can weigh commute, schools and budget together.</p>
    </div>
    <div class="comm">
      {AREAS.map((a) => (
        <a href={`/areas/${a.slug}/`}>
          <div class="ph">{PHOTO_SET[a.slug] && <Photo src={PHOTO_SET[a.slug].src} alt="" sizes="(max-width: 600px) 100vw, (max-width: 1100px) 50vw, 33vw" />}<span class="drive">{DRIVE[a.slug]?.[0]}</span></div>
          <div class="row"><div><div class="name">{a.name}</div><div class="county">{DRIVE[a.slug]?.[1]}</div></div><span aria-hidden="true" style="color:var(--navy);font-size:20px">→</span></div>
        </a>
      ))}
    </div>
    <p class="photo-credit" style="margin-top:24px">Area photos via Wikimedia Commons. <a href="/photo-credits/">Photo credits</a></p>
  </section>

  <section class="wrap" id="guides" style="scroll-margin-top:90px">
    <div class="band" style="display:grid;gap:36px">
      <div class="split" style="align-items:end;gap:16px 64px">
        <div class="stack" style="gap:14px"><p class="eyebrow">Free guides</p><h2 class="h2">Moving here? Start with these.</h2></div>
        <p class="body">Two guides from Devin. Enter your name and email and both download instantly.</p>
      </div>
      <div class="guides">
        {GUIDES.map((g) => (
          <div class="guide">
            <div class="cover"><img src="/assets/bg-primary.png" alt="" width="39" height="20" />{g.short}</div>
            <div class="stack" style="gap:8px"><h3>{g.title}</h3><p>{g.desc}</p><a class="link dl" href={g.file} download hidden data-guide-dl>Download PDF ↓</a></div>
          </div>
        ))}
      </div>
      <div class="guide-form"><LeadForm kind="guide" /></div>
    </div>
  </section>

  {REVIEWS.length > 0 && (
    <section class="wrap section">
      <div class="head-row">
        <div class="stack" style="gap:14px"><p class="eyebrow">Reviews</p><h2 class="h2">What clients say</h2></div>
        {SITE.googleReviewsUrl && <a class="link" href={SITE.googleReviewsUrl} target="_blank" rel="noopener">All reviews on Google ↗</a>}
      </div>
      <div class="reviews">{REVIEWS.map((r) => <figure><div class="stars" aria-label="5 stars">★★★★★</div><blockquote>{r.q}</blockquote><figcaption>{r.who}</figcaption></figure>)}</div>
    </section>
  )}

  <TikTokRow min={3} />

  <section class="wrap section">
    <div class="band cta-final">
      <div class="stack" style="gap:14px"><p class="eyebrow">Let’s make your move happen</p><h2 class="h2">A 15-minute call is the fastest way to a clear plan.</h2></div>
      <div class="btn-row"><a class="btn" href={SITE.smsHref}>Text Devin</a><a class="btn btn-outline" href={SITE.phoneHref}>Call {SITE.phone}</a></div>
    </div>
  </section>
</Base>

<style>
  .hero-home { min-height: clamp(560px, 80vh, 780px); }
  .hero-grid { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; }
  .hero-sub { margin: 0; font-size: 19px; line-height: 1.5; color: var(--ivory); max-width: 480px; }
  .hero-home > .photo-credit { position: absolute; z-index: 1; right: 20px; top: 16px; margin: 0; color: rgba(243, 241, 238, .85); font-size: 11px; text-shadow: 0 1px 4px rgba(4, 3, 3, .5); }
  .tt-card { position: relative; flex: none; width: 210px; aspect-ratio: 9 / 16; border-radius: 22px; overflow: hidden; background: var(--navy); box-shadow: 0 18px 44px rgba(4, 3, 3, .4); color: var(--ivory); text-decoration: none; transition: transform .25s; }
  .tt-card:hover { transform: translateY(-4px); text-decoration: none; }
  .tt-card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(16, 39, 86, 0) 45%, rgba(16, 39, 86, .92)); }
  .tt-card .tt-play { z-index: 1; }
  .tt-txt { position: absolute; z-index: 1; left: 16px; right: 16px; bottom: 16px; font: 700 15px/1.3 var(--sans); }
  .tt-txt small { display: block; margin-top: 4px; font-weight: 600; font-size: 13px; opacity: .85; }
  .meet .photo { min-height: 560px; }
  .pills { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .pills li { padding: 9px 14px; border-radius: 999px; background: var(--paper); border: 1px solid var(--line); font: 700 14px/1 var(--sans); color: var(--navy); }
  .fine-print { margin: 24px 0 0; font-size: 13px; }
  .fine-print a { color: var(--taupe); text-decoration: underline; }
  .cta-final { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 24px 64px; align-items: end; }
  @media (max-width: 700px) {
    .hero-home { min-height: 0; padding-top: 220px; }
    .hero-home > .wrap { position: static; }
    .hero-home .hero-panel { position: relative; z-index: 1; }
    .tt-card { position: absolute; z-index: 2; top: 16px; right: 16px; width: 104px; border-radius: 16px; }
    .tt-card .tt-txt { display: none; }
    .tt-card .tt-play { width: 32px; height: 32px; font-size: 12px; left: 10px; top: 10px; }
    .hero-home > .photo-credit { top: auto; bottom: 8px; right: 12px; }
    .hero-panel h1 { font-size: 46px; }
    .hero-sub { font-size: 16px; }
    .hero-home .btn-row .btn { flex: 1 1 100%; }
    .meet .photo { min-height: 420px; }
  }
</style>

<script>
  document.addEventListener('lead:sent', (e) => {
    if ((e.target as HTMLElement).closest('.guide-form')) document.querySelectorAll<HTMLElement>('[data-guide-dl]').forEach((a) => (a.hidden = false));
  });
</script>
