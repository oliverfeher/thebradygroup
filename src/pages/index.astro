---
import Base from '../layouts/Base.astro';
import ListingGrid from '../components/ListingGrid.astro';
import TikTokRow from '../components/TikTokRow.astro';
import LeadForm from '../components/LeadForm.astro';
import { AREAS, SITE, STATS, STATS_NOTE, STATS_SOURCE, GUIDES, REVIEWS, DRIVE } from '../data/site';
const book = SITE.bookingUrl || '/contact/';
const tiles = [['Free guides', 'Relocation & VA', '#guides'], ['Explore', 'Communities', '#communities'], ['Sellers', 'Home value', '/sell/#valuation'], ['Military', 'VA & PCS moves', '/military/'], ['Watch', 'Devin on TikTok', '#tiktok']];
const services = [
  ['01', 'Buying', 'Private showings, local pricing knowledge and a clear plan from offer to keys.', 'Start your search', '/buy/'],
  ['02', 'Selling', 'Your home is priced with care, professionally presented and negotiated with discipline.', 'Get a home value', '/sell/'],
  ['03', 'Military moves', 'PCS to Seymour Johnson AFB with a veteran who knows VA loans and tight timelines.', 'Relocation guide', '/military/'],
];
---
<Base title="The Brady Group | Goldsboro, NC Real Estate" description="Devin Brady, REALTOR® and U.S. Air Force veteran, helps buyers, sellers and military families in Goldsboro, Wayne County, Seymour Johnson AFB and the Triangle.">
  <section class="hero" style="background-image:url(/assets/hero.png)">
    <div class="wrap">
      <div class="hero-panel">
        <p class="eyebrow">Devin Brady, REALTOR® · Goldsboro, NC</p>
        <h1>Eastern North Carolina homes, handled with care.</h1>
        <div class="btn-row">
          <a class="btn" href="/listings/">View listings</a>
          <a class="btn btn-outline" href="/sell/#valuation">What's my home worth</a>
        </div>
      </div>
    </div>
  </section>

  <nav class="rule-bottom" aria-label="Quick links" style="border-bottom:1px solid var(--gray)">
    <div class="wrap tiles">{tiles.map(([k, v, href]) => <a href={href}><span class="eyebrow" style="font-size:11px">{k}</span><span class="v">{v}<span aria-hidden="true">→</span></span></a>)}</div>
  </nav>

  <section class="wrap section">
    <div class="head-row">
      <div class="stack" style="gap:18px"><p class="eyebrow">Featured</p><h2 class="h2">Current listings</h2></div>
      <a class="link" href="/listings/">All listings →</a>
    </div>
    <ListingGrid featured limit={3} />
  </section>

  <TikTokRow />

  <section class="photo-split">
    <div class="photo" style="background-image:url(/assets/devin-headshot.png)" role="img" aria-label="Devin Brady"></div>
    <div class="text">
      <h2 class="h2">Meet Devin Brady</h2>
      <p class="body">Devin is a REALTOR® and U.S. Air Force veteran based in Goldsboro. He works with buyers, sellers and military families across Wayne County and the Triangle.</p>
      <p class="body">Every home is priced with care, presented properly and negotiated with discipline. You'll always know where things stand.</p>
      <div><a class="link" href="/about/">About The Brady Group →</a></div>
    </div>
  </section>

  <section class="rule-top">
    <div class="wrap" style="padding-top:72px;padding-bottom:72px;display:grid;gap:36px">
      <div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px 32px;flex-wrap:wrap"><p class="eyebrow">Devin's track record</p><a class="link muted" style="font-size:11px" href={STATS_SOURCE} target="_blank" rel="noopener">{STATS_NOTE} ↗</a></div>
      <dl class="stats">{STATS.map(([v, k]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
    </div>
  </section>

  <section class="navy">
    <div class="wrap section">
      <h2 class="h2" style="margin-bottom:56px">How we help</h2>
      <div class="steps">
        {services.map(([n, t, d, cta, href]) => (
          <div class="step"><div class="n">{n}</div><h3 style="font-size:30px">{t}</h3><p>{d}</p><div><a class="link" href={href}>{cta} →</a></div></div>
        ))}
      </div>
    </div>
  </section>

  <section class="rule-top" id="communities">
    <div class="wrap section">
      <div class="split" style="align-items:end;margin-bottom:48px;gap:24px 64px">
        <div class="stack" style="gap:18px"><p class="eyebrow">Where you'll live</p><h2 class="h2">Communities near the base</h2></div>
        <p class="body" style="max-width:520px">Every community with its approximate drive to Seymour Johnson AFB, so you can weigh commute, schools and budget together.</p>
      </div>
      <div class="comm">
        {AREAS.map((a) => (
          <a href={`/areas/${a.slug}/`}>
            <div class="ph" style={a.photo ? `background-image:url(${a.photo})` : ''}><span class="drive">{DRIVE[a.slug]?.[0]}</span></div>
            <div class="row"><div><div class="name">{a.name}</div><div class="county">{DRIVE[a.slug]?.[1]}</div></div><span aria-hidden="true" style="color:var(--navy);font-size:18px">→</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="navy" id="guides" style="scroll-margin-top:24px">
    <div class="wrap section" style="display:grid;gap:48px">
      <div class="split" style="align-items:end;gap:24px 80px">
        <div class="stack" style="gap:18px"><p class="eyebrow">Free guides</p><h2 class="h2">Moving here? Start with these.</h2></div>
        <p class="body" style="max-width:520px">Two guides from Devin. Enter your name and email and both download instantly.</p>
      </div>
      <div class="guides">
        {GUIDES.map((g) => (
          <div class="guide">
            <div class="cover"><img src="/assets/bg-primary.png" alt="" />{g.short}</div>
            <div class="stack" style="gap:10px"><h3>{g.title}</h3><p>{g.desc}</p><a class="link dl" href={g.file} download hidden data-guide-dl>Download PDF ↓</a></div>
          </div>
        ))}
      </div>
      <div class="guide-form"><LeadForm kind="guide" /></div>
    </div>
  </section>

  {REVIEWS.length > 0 && (
    <section class="wrap section">
      <div class="head-row">
        <div class="stack" style="gap:18px"><p class="eyebrow">Google reviews</p><h2 class="h2">What clients say</h2></div>
        {SITE.googleReviewsUrl && <a class="link" href={SITE.googleReviewsUrl} target="_blank" rel="noopener">All reviews on Google ↗</a>}
      </div>
      <div class="reviews">{REVIEWS.map((r) => <figure><div class="stars" aria-label="5 stars">★★★★★</div><blockquote>{r.q}</blockquote><figcaption>{r.who}</figcaption></figure>)}</div>
    </section>
  )}

  <section class="photo-split navy" style="border-top:0">
    <div class="photo" style="background-image:url(/assets/devin-headshot.png);min-height:440px" role="img" aria-label="Devin Brady"></div>
    <div class="text">
      <p class="eyebrow">Let's make your move happen</p>
      <h2 class="h2">Work with The Brady Group</h2>
      <p class="body">Buying, selling or on orders, a 15-minute call is the fastest way to a clear plan.</p>
      <div class="btn-row"><a class="btn" href={book} target={SITE.bookingUrl ? '_blank' : undefined}>Schedule a call</a><a class="btn btn-outline" href={SITE.phoneHref}>{SITE.phone}</a></div>
    </div>
  </section>
</Base>

<script>
  document.addEventListener('lead:sent', (e) => {
    if ((e.target as HTMLElement).closest('.guide-form')) document.querySelectorAll<HTMLElement>('[data-guide-dl]').forEach((a) => (a.hidden = false));
  });
</script>
