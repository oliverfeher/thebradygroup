---
// Attribution for third-party photos (Wikimedia Commons). Required for the CC BY-SA images.
import Base from '../layouts/Base.astro';
import { AREAS, PHOTO_SET } from '../data/site';
const rows = AREAS.filter((a) => PHOTO_SET[a.slug]).map((a) => ({ area: a.name, ...PHOTO_SET[a.slug] }));
---
<Base title="Photo Credits" description="Credits and licenses for photos used on bradygrouphomes.com." noindex>
  <section class="wrap section" style="max-width:860px">
    <div class="stack" style="gap:18px;margin-bottom:40px"><p class="eyebrow">Photo credits</p><h1 class="display">Photo credits</h1>
      <p class="body">Area photos come from Wikimedia Commons and are used under the licenses below. Photos marked CC BY-SA may be reused under the same license.</p></div>
    <ul class="rule-list credits">
      {rows.map((r) => (
        <li>
          <span class="eyebrow">{r.area}</span>
          <span><a href={r.url} target="_blank" rel="noopener license">{r.subject}</a> by {r.author}</span>
          <span class="lic">{r.license}{r.license.startsWith('CC BY') && <> · <a href={`https://creativecommons.org/licenses/by-sa/${r.license.replace(/[^0-9.]/g, '')}/`} target="_blank" rel="noopener license">license</a></>}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .credits { list-style: none; margin: 0; padding: 0; }
  .credits li { display: grid; gap: 6px; padding: 18px 0; border-bottom: 1px solid var(--gray); font-size: 15px; color: var(--brown); }
  .credits .lic { font-size: 13px; color: var(--taupe); }
</style>
