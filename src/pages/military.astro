---
import Base from '../layouts/Base.astro';
import Steps from '../components/Steps.astro';
import Photo from '../components/Photo.astro';
import Tools from '../components/Tools.astro';
import { MIL_POINTS, SITE, MILITARY_PHOTO, photoCredit } from '../data/site';
---
<Base title="PCS to Seymour Johnson AFB | Military Moves" active="Military" description="Moving to Seymour Johnson AFB? Devin Brady, a REALTOR® and U.S. Air Force veteran, helps military families with VA loans, BAH budgets, remote buying and PCS timelines.">
  <section class="hero on-photo">
    <Photo src={MILITARY_PHOTO.src} eager position="center 30%" />
    <div class="wrap">
      <div class="hero-panel">
        <p class="eyebrow">Military moves · Seymour Johnson AFB</p>
        <h1>PCS to Seymour Johnson AFB</h1>
        <p style="margin:0;font-size:18px;line-height:1.55;max-width:480px">Devin served in the Air Force and knows how orders shape a move. He plans the search around your report date, not the other way around.</p>
        <div class="btn-row"><a class="btn" href={SITE.smsHref}>Text Devin</a><a class="btn btn-outline" href="#tools">See what your BAH buys</a></div>
      </div>
    </div>
  </section>

  <Tools heading="Your PCS toolkit" intro="Check what your BAH buys with a VA loan, build a timeline from your report date, and compare commutes to the base." />

  <section class="wrap section">
    <div class="head-row"><div class="stack" style="gap:14px"><p class="eyebrow">How Devin helps</p><h2 class="h2">Built around your orders</h2></div></div>
    <Steps steps={MIL_POINTS} numbered={false} />
  </section>

  <section class="wrap section rule-top split center">
    <div class="stack" style="gap:14px"><p class="eyebrow">Near the base</p><h2 class="h2">Where airmen and families live</h2></div>
    <div class="stack" style="justify-items:start"><p class="body">Neighborhoods, commute times and VA loan details for the areas around Seymour Johnson AFB.</p><a class="link" href="/areas/seymour-johnson-afb/">Homes near Seymour Johnson AFB →</a></div>
  </section>
  <p class="wrap photo-credit">Hero photo: {MILITARY_PHOTO.subject}. {photoCredit(MILITARY_PHOTO)}.</p>
</Base>
