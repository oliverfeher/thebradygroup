---
// Self-hosted fonts (no render-blocking Google Fonts request); latin subset only.
import '@fontsource/tinos/latin-400.css';
import '@fontsource/tinos/latin-700.css';
import '@fontsource/mulish/latin-400.css';
import '@fontsource/mulish/latin-600.css';
import '@fontsource/mulish/latin-700.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { AREAS, SITE, PHOTOS } from '../data/site';

interface Props { title: string; description: string; active?: string; jsonLd?: object[]; image?: string; noindex?: boolean; source?: string }
const { title, description, active = '', jsonLd = [], image, noindex = false, source } = Astro.props;
// Social share image (default: the Goldsboro hero) and the agent photo for structured data, both resized at build.
const ogImage = image ?? (await getImage({ src: PHOTOS.hero, width: 1200, format: 'jpg' })).src;
const agentImage = (await getImage({ src: PHOTOS.headshot, width: 600, format: 'jpg' })).src;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title.includes('Brady Group') ? title : `${title} | The Brady Group`;
const agent = {
  '@context': 'https://schema.org', '@type': 'RealEstateAgent', '@id': `${SITE.url}/#agent`,
  name: 'The Brady Group', url: SITE.url, telephone: '+1-316-730-3642', email: SITE.email,
  image: new URL(agentImage, SITE.url).href, logo: `${SITE.url}/assets/bg-primary.png`,
  address: { '@type': 'PostalAddress', addressLocality: 'Goldsboro', addressRegion: 'NC', addressCountry: 'US' },
  areaServed: AREAS.map((a) => ({ '@type': 'Place', name: `${a.name}, NC` })),
  employee: { '@type': 'Person', name: SITE.agent, jobTitle: 'REALTOR®' },
  parentOrganization: { '@type': 'Organization', name: SITE.brokerage },
};
---
<!doctype html>
<html lang="en" data-src={source}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="The Brady Group">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={new URL(ogImage, Astro.site).href}>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" type="image/png" href="/favicon.png">
  <script type="application/ld+json" set:html={JSON.stringify([agent, ...jsonLd])} />
  <script is:inline>
    // First-touch lead source (kept 90 days) so CRM leads show where they came from.
    // Links can force it: bradygrouphomes.com/?src=tiktok or ?utm_source=…&utm_campaign=…
    // A page can force it too (<Base source="tiktok">, used by the /start/ link-in-bio page).
    try {
      var K = 'tbg_src', old = JSON.parse(localStorage.getItem(K) || 'null');
      var p = new URLSearchParams(location.search), forced = p.get('src') || p.get('utm_source') || document.documentElement.dataset.src;
      if (forced || !old || Date.now() - old.at > 7776e6) {
        var r = '';
        try { r = document.referrer ? new URL(document.referrer).hostname : ''; } catch (e) {}
        var known = { tiktok: 'tiktok', google: 'google', bing: 'bing', instagram: 'instagram', facebook: 'facebook', youtube: 'youtube', zillow: 'zillow', realtor: 'realtor' };
        var fromRef = Object.keys(known).find(function (k) { return r.indexOf(k) !== -1; });
        var ownSite = r.indexOf('bradygrouphomes.com') !== -1;
        if (forced || !old || !ownSite) {
          localStorage.setItem(K, JSON.stringify({
            source: (forced || (fromRef && known[fromRef]) || (r && !ownSite ? 'referral' : 'website')).toLowerCase().slice(0, 40),
            detail: (p.get('utm_campaign') || (r && !ownSite && !fromRef ? r : '') || location.pathname).slice(0, 200),
            at: Date.now(),
          }));
        }
      }
    } catch (e) {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Nav active={active} />
  <main id="main"><slot /></main>
  <Footer />
</body>
</html>
