---
import { SITE } from '../data/site';
interface Props { limit?: number }
const { limit = 8 } = Astro.props;
---
<section class="rule-top" id="tiktok" hidden>
  <div class="wrap section">
    <div class="head-row" style="margin-bottom:40px">
      <div class="stack" style="gap:18px"><p class="eyebrow">On TikTok</p><h2 class="h2">Watch Devin</h2></div>
      <a class="btn" href={SITE.tiktokProfile} target="_blank" rel="noopener">Follow on TikTok ↗</a>
    </div>
    <div class="tt-row" data-limit={String(limit)}></div>
  </div>
</section>
<script>
  import { supabase } from '../lib/supabase';
  import { esc } from '../lib/listings';
  const sec = document.getElementById('tiktok')!;
  const row = sec.querySelector<HTMLElement>('.tt-row')!;
  supabase.from('videos').select('url,caption,views,thumb').eq('visible', true).order('sort').limit(Number(row.dataset.limit) || 8)
    .then(({ data, error }) => {
      if (error || !data?.length) return;
      row.innerHTML = data.map((v) => `
        <a class="tt" href="${esc(v.url)}" target="_blank" rel="noopener">
          <span class="tt-thumb">${v.thumb ? `<img src="${esc(v.thumb)}" alt="" loading="lazy">` : ''}
            <span class="tt-play" aria-hidden="true">▶</span>
            <span class="tt-bar"><span>${v.views ? esc(v.views) + ' views' : 'Watch'}</span><span>TikTok ↗</span></span>
          </span>
          <span class="tt-cap">${esc(v.caption || 'Watch on TikTok')}</span>
        </a>`).join('');
      sec.hidden = false;
    });
</script>
