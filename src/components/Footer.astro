---
import { AREAS, SITE } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer-in">
    <div class="footer-cols">
      <div>
        <img src="/assets/bg-primary.png" alt="The Brady Group">
        <p class="body" style="font-size:15px;max-width:260px">Real estate across Eastern North Carolina, from Goldsboro to the Triangle.</p>
      </div>
      <div>
        <p class="eyebrow">Explore</p>
        <a href="/listings/">Listings</a><a href="/buy/">Buying</a><a href="/sell/">Selling</a><a href="/military/">Military moves</a><a href="/about/">About</a>
      </div>
      <div>
        <p class="eyebrow">Areas</p>
        {AREAS.map((a) => <a href={`/areas/${a.slug}/`}>{a.name}</a>)}
      </div>
      <div>
        <p class="eyebrow">Contact</p>
        <a href={SITE.phoneHref} class="price" style="font-size:20px">{SITE.phone}</a>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <span style="color:var(--brown)">Goldsboro, NC</span>
      </div>
    </div>
    <div class="cobrand">
      <img src="/assets/firm-nc.png" alt="The Firm NC">
      <span aria-hidden="true"></span>
      <img src="/assets/bg-primary.png" alt="The Brady Group">
    </div>
    <div class="legal">
      <div>{SITE.agent}, REALTOR® · The Brady Group · Brokered by {SITE.brokerage} · NC Lic #{SITE.license}</div>
      <div>Equal Housing Opportunity · © {year} The Brady Group</div>
    </div>
  </div>
</footer>
