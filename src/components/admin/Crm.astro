}
det.elements.phone.addEventListener('change', checkDetDupes);
det.elements.email.addEventListener('change', checkDetDupes);
det.addEventListener('submit', async (e) => {
  e.preventDefault();
  const v = Object.fromEntries(DFIELDS.map((k) => [k, det.elements[k].value.trim()]));
  if (!v.name) { $('#cd-err').textContent = 'Name is required.'; $('#cd-err').hidden = false; return; }
  const values = Object.fromEntries(DFIELDS.map((k) => [k, v[k] || null]));
  values.category = v.category || 'lead';
  values.tags = [...new Set(v.tags.split(',').map((t) => t.trim()).filter(Boolean))];
  if (values.category === 'lead' && !cur.stage) values.stage = 'new';
  $('#cd-err').hidden = true;
  const d = await patchContact(cur.id, values, 'Details saved');
  if (d) { fillDetails(); if (values.stage) loadTimeline(); }
});
$('#cd-del').addEventListener('click', async () => {
  if (!delArm) { delArm = true; $('#cd-del').textContent = 'Click again to delete for good'; return; }
  const id = cur.id;
  const { error } = await sb.from('contacts').delete().eq('id', id);
  if (error) return fail(error, 'Couldn’t delete');
  contacts = contacts.filter((c) => c.id !== id);
  $('#cd-del').textContent = 'Delete contact';
  closeContact(); rerender(); toast('Contact deleted');
});

/* ---------- quick add ---------- */
const qaf = $('#qa-form');
const QA = {
  category: CATS,
  lead_type: TYPES,
  status: [['new', 'Need to reach out'], ['contacted', 'Already talking']],
  source: SOURCES.filter(([k]) => ['tiktok', 'instagram', 'facebook', 'referral', 'website', 'open_house', 'other'].includes(k)),
};
let qa = {};
function openQuick(category = 'lead') {
  qa = { category, lead_type: null, status: 'new', source: category === 'lead' ? 'tiktok' : null };
  qaf.reset(); $('#qa-err').hidden = true; $('#qa-dupe').hidden = true;
  drawQuick();
  $('#qa').hidden = false; document.body.style.overflow = 'hidden';
  setTimeout(() => qaf.elements.name.focus(), 60);
}
function closeQuick() { $('#qa').hidden = true; if (!cur) document.body.style.overflow = ''; }
function drawQuick() {
  qaf.querySelectorAll('[data-pick]').forEach((el) => (el.innerHTML = chips(QA[el.dataset.pick], qa[el.dataset.pick])));
  qaf.querySelectorAll('[data-lead-only]').forEach((el) => (el.hidden = qa.category !== 'lead'));
  $('#qa-title').textContent = qa.category === 'lead' ? 'Add lead' : 'Add contact';
}
qaf.addEventListener('click', (e) => {
  const b = e.target.closest('[data-pick] button'); if (!b) return;
  const k = b.closest('[data-pick]').dataset.pick, v = b.dataset.v;
  qa[k] = qa[k] === v && (k === 'lead_type' || k === 'source') ? null : v;
  drawQuick();
});
document.querySelectorAll('#qa [data-x]').forEach((el) => el.addEventListener('click', closeQuick));
let dupeT;
qaf.addEventListener('input', (e) => {
  if (e.target.name !== 'phone' && e.target.name !== 'email') return;
  clearTimeout(dupeT);
  dupeT = setTimeout(() => {
    const d = findDupes(qaf.elements.phone.value, qaf.elements.email.value);
    $('#qa-dupe').hidden = !d.length; if (d.length) $('#qa-dupe').innerHTML = dupeHtml(d);
  }, 250);
});
qaf.addEventListener('submit', async (e) => {
  e.preventDefault();
  const f = qaf.elements, name = f.name.value.trim(), note = f.note.value.trim(), err = $('#qa-err');
  if (!name) { err.textContent = 'Add a name.'; err.hidden = false; return; }
  if (f.email.value.trim() && !/^\S+@\S+\.\S+$/.test(f.email.value.trim())) { err.textContent = 'That email doesn’t look right.'; err.hidden = false; return; }
  const lead = qa.category === 'lead', talking = lead && qa.status === 'contacted';
  const row = {
    name, phone: f.phone.value.trim() || null, email: f.email.value.trim() || null,
    category: qa.category, lead_type: lead ? qa.lead_type : null, source: qa.source,
    stage: lead ? qa.status : null,
    next_follow_up: lead ? (talking ? addDays(2) : today()) : null,
    last_contacted_at: talking ? new Date().toISOString() : null,
  };
  const btn = qaf.querySelector('[type=submit]'); btn.disabled = true;
  const { data, error } = await sb.from('contacts').insert(row).select().single();
  if (!error && note) await sb.from('activities').insert({ contact_id: data.id, kind: 'note', body: note });
  btn.disabled = false;
  if (error) return fail(error, 'Couldn’t save');
  keep(data); rerender(); closeQuick();
  toast(`${name} added`);
});

/* ---------- import ---------- */
let imp = null, impCat = 'sphere';
$('#c-import').addEventListener('click', () => {
  imp = null; $('#imp-preview').hidden = true; $('#imp-err').hidden = true; $('#imp-go').disabled = true; $('#imp-tag').value = '';
  $('#imp').hidden = false; document.body.style.overflow = 'hidden';
});
const closeImport = () => { $('#imp').hidden = true; document.body.style.overflow = ''; };
document.querySelectorAll('#imp [data-x]').forEach((el) => el.addEventListener('click', closeImport));
$('#imp-cat').addEventListener('click', (e) => { const b = e.target.closest('button'); if (b) { impCat = b.dataset.v; drawImport(); } });

function parseVcf(text) {
  const lines = text.replace(/\r\n?/g, '\n').replace(/\n[ \t]/g, '').split('\n');
  const val = (s) => s.replace(/\\n/gi, ' ').replace(/\\([,;\\])/g, '$1').trim();
  const qp = (s) => { try { return decodeURIComponent(s.replace(/=([0-9A-F]{2})/gi, '%$1')); } catch { return s; } };
  const out = []; let c = null;
  for (const raw of lines) {
    const i = raw.indexOf(':'); if (i < 0) continue;
    const [prop0, ...params] = raw.slice(0, i).split(';');
    const prop = prop0.split('.').pop().toUpperCase(), p = params.join(';').toUpperCase();
    let v = raw.slice(i + 1);
    if (p.includes('QUOTED-PRINTABLE')) v = qp(v);
    if (prop === 'BEGIN') { c = { phones: [], emails: [] }; continue; }
    if (!c) continue;
    if (prop === 'END') { out.push(c); c = null; }
    else if (prop === 'FN') c.fn = val(v);
    else if (prop === 'N') { const [last, first, mid] = v.split(';').map(val); c.n = [first, mid, last].filter(Boolean).join(' '); }
    else if (prop === 'TEL') c.phones[/CELL|IPHONE|MOBILE/.test(p) ? 'unshift' : 'push'](val(v).replace(/^tel:/i, ''));
    else if (prop === 'EMAIL') c.emails.push(val(v));
    else if (prop === 'ORG') c.org = val(v.split(';')[0]);
  }
  return out.map((c) => ({ name: c.fn || c.n || '', phone: c.phones[0] || '', email: c.emails[0] || '', company: c.org || '' }));
}
function parseCsv(text) {
  const rows = []; let row = [], f = '', q = false;
  text = text.replace(/^﻿/, '');
  for (let i = 0; i < text.length; i++) {
    const ch = text[i];
    if (q) { if (ch === '"') { if (text[i + 1] === '"') { f += '"'; i++; } else q = false; } else f += ch; }
    else if (ch === '"') q = true;
    else if (ch === ',') { row.push(f); f = ''; }
    else if (ch === '\n' || ch === '\r') { if (ch === '\r' && text[i + 1] === '\n') i++; row.push(f); rows.push(row); row = []; f = ''; }
    else f += ch;
  }
  if (f || row.length) { row.push(f); rows.push(row); }
  const data = rows.filter((r) => r.some((x) => x.trim()));
  if (data.length < 2) return [];
  const h = data[0].map((x) => x.trim().toLowerCase());
  const find = (re) => h.findIndex((x) => re.test(x) && !/label|type/.test(x));
  const iName = find(/^(name|full name|display name|contact name)$/), iFirst = find(/^(first name|given name|first)$/), iMid = find(/^(middle name|additional name)$/), iLast = find(/^(last name|family name|surname|last)$/);
  const iPhone = find(/phone|mobile|cell/), iEmail = find(/e-?mail/), iOrg = find(/^(company|organization|organization name|organization 1 - name)$/);
  const get = (r, i) => (i >= 0 ? (r[i] || '').split(' ::: ')[0].trim() : '');
  return data.slice(1).map((r) => ({ name: get(r, iName) || [get(r, iFirst), get(r, iMid), get(r, iLast)].filter(Boolean).join(' '), phone: get(r, iPhone), email: get(r, iEmail), company: get(r, iOrg) }));
}
$('#imp-file').addEventListener('change', async (e) => {
  const file = e.target.files[0]; e.target.value = '';
  if (!file) return;
  const text = await file.text();
  const raw = /BEGIN:VCARD/i.test(text) ? parseVcf(text) : parseCsv(text);
  const phones = new Set(contacts.map((c) => c.phone_norm).filter(Boolean)), emails = new Set(contacts.map((c) => c.email_norm).filter(Boolean));
  let dupes = 0, skipped = 0; const rows = [];
  for (const r of raw) {
    const p = normPhone(r.phone), m = normEmail(r.email);
    if (!p && !m) { skipped++; continue; }
    if ((p && phones.has(p)) || (m && emails.has(m))) { dupes++; continue; }
    if (p) phones.add(p); if (m) emails.add(m);
    rows.push({ name: (r.name || r.email || showPhone(r.phone)).slice(0, 120), phone: r.phone || null, email: r.email || null, company: r.company || null });
  }
  imp = { rows, dupes, skipped, file: file.name };
  if (!raw.length) { $('#imp-err').textContent = 'No contacts found in that file. Use a .vcf export or a CSV with a header row.'; $('#imp-err').hidden = false; return; }
  $('#imp-err').hidden = true;
  drawImport();
});
function drawImport() {
  if (!imp) return;
  $('#imp-preview').hidden = false;
  $('#imp-sum').textContent = `${imp.rows.length} new contact${imp.rows.length === 1 ? '' : 's'} ready` + (imp.dupes ? ` · ${imp.dupes} already in your CRM` : '') + (imp.skipped ? ` · ${imp.skipped} skipped (no phone or email)` : '') + '.';
  $('#imp-cat').innerHTML = chips(CATS, impCat);
  $('#imp-go').disabled = !imp.rows.length;
  $('#imp-go').textContent = imp.rows.length ? `Import ${imp.rows.length}` : 'Import';
}
$('#imp-go').addEventListener('click', async () => {
  const btn = $('#imp-go'), tag = $('#imp-tag').value.trim();
  const rows = imp.rows.map((r) => ({ ...r, category: impCat, stage: impCat === 'lead' ? 'nurture' : null, source: 'import', source_detail: imp.file.slice(0, 200), tags: tag ? [tag] : [] }));
  btn.disabled = true;
  let done = 0;
  for (let i = 0; i < rows.length; i += 500) {
    btn.textContent = `Importing ${done}/${rows.length}…`;
    const { error } = await sb.from('contacts').insert(rows.slice(i, i + 500));
    if (error) { fail(error, `Import stopped after ${done}`); break; }
    done += Math.min(500, rows.length - i);
  }
  await loadContacts(true); rerender(); closeImport();
  if (done) toast(`Imported ${done} contacts`);
});

document.addEventListener('keydown', (e) => {
  if (e.key !== 'Escape') return;
  if (!$('#qa').hidden) closeQuick(); else if (!$('#imp').hidden) closeImport(); else if (cur) closeContact();
});
</script>
