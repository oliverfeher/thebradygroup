      <span class="dm">${[d.side === 'seller' ? 'Seller side' : 'Buyer side', d.price != null && money(d.price), d.price != null && d.commission_pct != null && `${Number(d.commission_pct)}% = ${money(commission(d))}`, d.closing_date && (d.status === 'closed' ? 'Closed ' : 'Closing ') + fmtDay(d.closing_date)].filter(Boolean).map(esc).join(' · ')}</span>
    </button>`).join('') : '<p class="sec-empty">No deals yet. Add one when they go under contract.</p>';
}
function openDealForm(d) {
  const f = dealForm; dealEdit = d || null; dealDelArm = false;
  f.reset();
  dealSide = d?.side || (cur.lead_type === 'seller' ? 'seller' : 'buyer');
  $('#df-side').innerHTML = chips([['buyer', 'Buyer side'], ['seller', 'Seller side']], dealSide);
