    const { data } = await sb.from('contacts').select('*').eq('id', id).maybeSingle();
    if (!data) { toast('Contact not found'); return history.replaceState(null, '', '#' + (view || 'today')); }
    keep(data); c = data;
  }
  cur = c; delArm = false; delAct = null; acts = []; shows = [];
  logKind = kind || 'note';
  $('#cd-log').reset();
  closeDealForm(); closeShowForm(); $('#cd-tpl').hidden = true;
  $('#tbg-listings').innerHTML = listingOpts.map((l) => `<option value="${esc(l.street + ', ' + l.city)}">`).join('');
  $('#cd-fu-wrap').classList.remove('nudge');
  $('#cd-det').open = false;
  drawContact(); fillDetails();
  $('#cd').hidden = false; document.body.style.overflow = 'hidden';
  history.replaceState(null, '', '#c/' + id);
  loadTimeline(); loadShows();
  if (kind) setTimeout(() => $('#cd-log textarea').focus({ preventScroll: true }), 60);
}
function closeContact(restoreHash = true) {
  $('#cd').hidden = true; cur = null; document.body.style.overflow = '';
  if (restoreHash) history.replaceState(null, '', '#' + (view || 'today'));
}
function drawContact() {
  const c = cur, t = today();
  $('#cd-name').textContent = c.name;
  $('#cd-meta').innerHTML = [CAT[c.category], TYPE[c.lead_type], c.source && 'From ' + pretty(SOURCE, c.source) + (c.source_detail ? ` (${c.source_detail})` : ''), 'Added ' + ago(c.created_at), c.last_contacted_at && 'Last contacted ' + ago(c.last_contacted_at)]
    .filter(Boolean).map((x) => `<span>${esc(x)}</span>`).join('');
  const tel = telNum(c.phone);
  const btns = [
    tel && `<a class="btn" href="tel:${tel}" data-k="call">Call</a>`,
    tel && `<a class="btn ghost" href="sms:${tel}" data-k="text">Text</a>`,
    c.email && `<a class="btn ghost" href="mailto:${esc(c.email)}" data-k="email">Email</a>`,
  ].filter(Boolean).join('');
  $('#cd-acts').innerHTML = `<div class="cd-contact">${[showPhone(c.phone), c.email].filter(Boolean).map(esc).join(' · ') || 'No phone or email yet. Add them under Details.'}</div>` + (btns ? `<div class="cd-btns">${btns}</div><button type="button" class="tlink" id="cd-tpl-t">Send a template</button>` : '');
  const sel = $('#cd-stage');
  sel.innerHTML = options([...STAGES, ['', 'Not in pipeline']]);
  sel.value = c.stage || ''; sel.dataset.s = c.stage || '';
  $('#cd-fu').value = c.next_follow_up || '';
  $('#cd-fu-q').innerHTML = chips(FU_QUICK, null);
  $('#cd-fu-clear').hidden = !c.next_follow_up;
  $('#cd-fu-note').textContent = c.next_follow_up ? (c.next_follow_up < t ? '· overdue' : '· ' + fmtDay(c.next_follow_up)) : '';
  drawKinds(); drawDeals(); drawShows();
}
function drawKinds() {
  $('#cd-kind').innerHTML = chips(KINDS, logKind);
  $('#cd-outcome').innerHTML = OUTCOMES[logKind].map((o) => `<button type="button" data-o="${esc(o)}" aria-pressed="false">${esc(o)}</button>`).join('');
  $('#cd-outcome').hidden = !OUTCOMES[logKind].length;
}
async function loadTimeline() {
  const id = cur?.id; if (!id) return;
  if (!acts.length) $('#cd-tl').innerHTML = '<p class="hint">Loading…</p>';
  const { data, error } = await sb.from('activities').select('*').eq('contact_id', id).order('created_at', { ascending: false }).limit(300);
  if (cur?.id !== id) return;
  if (error) return fail(error, 'Couldn’t load timeline');
  acts = data; drawTimeline();
}
const stageName = (s) => STAGE[s] || 'Not in pipeline';
const LOCKED = ['form', 'stage', 'deal', 'showing'];
function drawTimeline() {
  // Showings live in their own table; fold them into the timeline by date.
  const items = [...acts, ...shows.map((sh) => ({ id: 's' + sh.id, created_at: sh.shown_on + 'T12:00:00', kind: 'showing', day: true, body: [sh.address, RATING[sh.rating], sh.feedback].filter(Boolean).join(' · ') }))]
    .sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
  $('#cd-tl').innerHTML = items.length ? items.map((a) => `
    <div class="tl-i" data-aid="${a.id}" data-k="${a.kind}">
      <div class="tl-h"><span class="lbl">${esc(KIND[a.kind] || a.kind)}</span><span class="tl-t">${esc(a.day ? fmtDay(a.created_at.slice(0, 10)) : when(a.created_at))}${a.created_by && a.created_by === session?.user.id ? ' · You' : ''}</span>
        ${KIND[a.kind] && !LOCKED.includes(a.kind) ? `<button type="button" class="tl-del" data-del>${delAct === a.id ? 'Confirm delete' : 'Delete'}</button>` : ''}</div>
      ${a.kind === 'stage' ? `<p>${esc(stageName(a.meta?.from))} → ${esc(stageName(a.meta?.to))}</p>` : a.body ? `<p>${esc(a.body)}</p>` : ''}
    </div>`).join('') : '<p class="hint">Nothing here yet. Log your first call, text or note above.</p>';
}

document.querySelectorAll('#cd [data-x]').forEach((el) => el.addEventListener('click', () => closeContact()));
$('#cd-acts').addEventListener('click', (e) => { const a = e.target.closest('[data-k]'); if (a) { logKind = a.dataset.k; drawKinds(); } });
$('#cd-stage').addEventListener('change', (e) => { if ((e.target.value || null) !== cur.stage) setStage(cur, e.target.value); });
$('#cd-fu').addEventListener('change', (e) => setFollowUp(e.target.value || null));
$('#cd-fu-q').addEventListener('click', (e) => { const b = e.target.closest('button'); if (b) setFollowUp(addDays(Number(b.dataset.v))); });
$('#cd-fu-clear').addEventListener('click', () => setFollowUp(null));
function setFollowUp(d) {
  $('#cd-fu-wrap').classList.remove('nudge');
  return patchContact(cur.id, { next_follow_up: d }, d ? `Follow up ${fmtDay(d)}` : 'Follow-up cleared');
}
$('#cd-kind').addEventListener('click', (e) => { const b = e.target.closest('button'); if (b) { logKind = b.dataset.v; drawKinds(); } });
$('#cd-outcome').addEventListener('click', (e) => {
  const b = e.target.closest('button'); if (!b) return;
  const ta = $('#cd-log textarea'), o = b.dataset.o + '. ';
  ta.value = ta.value.startsWith(o) ? ta.value : o + ta.value.replace(new RegExp('^(' + OUTCOMES[logKind].join('|') + ')\\. '), '');
  ta.focus();
});
$('#cd-log').addEventListener('submit', async (e) => {
  e.preventDefault();
  const f = e.target, body = f.body.value.trim(), btn = f.querySelector('.btn'), id = cur.id;
  if (!body && logKind === 'note') return toast('Write a note first');
  btn.disabled = true;
  const { error } = await sb.from('activities').insert({ contact_id: id, kind: logKind, body: body || null });
  btn.disabled = false;
  if (error) return fail(error, 'Couldn’t save');
  f.reset();
  const touch = logKind !== 'note';
  logKind = 'note'; drawKinds();
  const needNext = await afterTouch(id, touch);
  toast(needNext ? 'Logged. When should you follow up next?' : 'Logged');
});
// After anything lands on the timeline: refresh the contact (triggers may have moved the stage).
// A call/text/email/meeting completes a due follow-up, so clear it and nudge for the next one.
async function afterTouch(id, touch) {
  const fuDone = touch && cur?.id === id && cur.next_follow_up && cur.next_follow_up <= today();
  const { data } = fuDone
    ? await sb.from('contacts').update({ next_follow_up: null }).eq('id', id).select().single()
    : await sb.from('contacts').select('*').eq('id', id).single();
  if (data) { keep(data); if (cur?.id === id) { cur = data; drawContact(); } rerender(); }
  if (cur?.id === id) await loadTimeline();
  const needNext = touch && data && cur?.id === id && !data.next_follow_up && data.stage && data.stage !== 'closed' && data.stage !== 'lost';
  if (needNext) { $('#cd-fu-wrap').classList.add('nudge'); $('#cd-fu-wrap').scrollIntoView({ behavior: 'smooth', block: 'center' }); }
  return needNext;
}

/* ---------- templates (send from the contact drawer) ---------- */
const firstName = (n) => String(n || '').trim().split(/\s+/)[0] || '';
const fillTpl = (text, c) => String(text || '').replace(/\{first_name\}/g, firstName(c.name)).replace(/\{name\}/g, c.name);
const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
let tpls = [];
$('#cd-acts').addEventListener('click', async (e) => {
  if (!e.target.closest('#cd-tpl-t')) return;
  const box = $('#cd-tpl');
  if (!box.hidden) { box.hidden = true; return; }
  box.innerHTML = '<p class="hint">Loading…</p>'; box.hidden = false;
  const { data, error } = await sb.from('templates').select('*').order('sort').order('name');
  if (error) { box.innerHTML = '<p class="hint">Templates aren’t set up yet (run crm-v1.1.sql).</p>'; return; }
  tpls = data;
  const c = cur;
  box.innerHTML = tpls.length ? tpls.map((t) => {
    const off = t.channel === 'email' ? !c.email : !telNum(c.phone);
    return `<button type="button" data-tpl="${t.id}" ${off ? 'disabled' : ''}><b>${esc(t.name)}${t.channel === 'email' ? ' · Email' : ''}</b><span>${esc(off ? (t.channel === 'email' ? 'Needs an email address' : 'Needs a phone number') : fillTpl(t.body, c))}</span></button>`;
  }).join('') : '<p class="hint">No templates yet. Add some under Templates.</p>';
});
$('#cd-tpl').addEventListener('click', async (e) => {
  const b = e.target.closest('[data-tpl]'); if (!b || b.disabled) return;
  const t = tpls.find((x) => x.id === b.dataset.tpl), c = cur, body = fillTpl(t.body, c);
  const url = t.channel === 'email'
    ? `mailto:${c.email}?subject=${encodeURIComponent(fillTpl(t.subject, c))}&body=${encodeURIComponent(body)}`
    : `sms:${telNum(c.phone)}${isIOS ? '&' : '?'}body=${encodeURIComponent(body)}`;
  // Log first (Devin won't log it himself), then hand off to Messages / Mail.
  await sb.from('activities').insert({ contact_id: c.id, kind: t.channel === 'email' ? 'email' : 'text', body: `Sent "${t.name}": ${body}` });
  $('#cd-tpl').hidden = true;
  location.href = url;
  afterTouch(c.id, true);
});

/* ---------- deals ---------- */
let dealEdit = null, dealSide = 'buyer', dealDelArm = false;
const dealForm = $('#cd-deal-form');
dealForm.elements.status.innerHTML = options(DEAL_STATUS);
function drawDeals() {
  const list = deals.filter((d) => d.contact_id === cur.id);
