$('#df-side').addEventListener('click', (e) => { const b = e.target.closest('button'); if (b) { dealSide = b.dataset.v; $('#df-side').innerHTML = chips([['buyer', 'Buyer side'], ['seller', 'Seller side']], dealSide); } });
dealForm.querySelector('[data-cancel]').addEventListener('click', closeDealForm);
dealForm.addEventListener('submit', async (e) => {
  e.preventDefault();
