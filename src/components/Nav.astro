---
import { NAV, SITE } from '../data/site';
interface Props { active?: string }
const { active = '' } = Astro.props;
---
<header class="nav">
  <div class="wrap nav-in">
    <a href="/" class="nav-logo" aria-label="The Brady Group, home"><img src="/assets/bg-primary.png" alt="The Brady Group" height="56"></a>
    <nav class="nav-links" id="nav-links" aria-label="Main">
      {NAV.map(([label, href]) => <a href={href} aria-current={label === active ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="nav-end">
      <a class="btn" href={SITE.phoneHref}>{SITE.phone}</a>
      <button class="nav-toggle" type="button" aria-controls="nav-links" aria-expanded="false">Menu</button>
    </div>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const links = document.getElementById('nav-links');
  btn?.addEventListener('click', () => {
    const open = links!.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
    btn.textContent = open ? 'Close' : 'Menu';
  });
</script>
