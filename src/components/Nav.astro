---
import { NAV, SITE } from '../data/site';
interface Props { active?: string }
const { active = '' } = Astro.props;
---
<header class="nav">
  <div class="wrap nav-in">
    <a href="/" class="nav-logo" aria-label="The Brady Group, home"><img src="/assets/bg-primary.png" alt="The Brady Group" width="394" height="203"></a>
    <nav class="nav-links" id="nav-links" aria-label="Main">
      {NAV.map(([label, href]) => <a href={href} aria-current={label === active ? 'page' : undefined}>{label === 'Military' ? 'PCS & military' : label}</a>)}
      {SITE.socials.filter(([, u]) => u).map(([l, u]) => <a class="m-only" href={u} target="_blank" rel="noopener">{l} ↗</a>)}
    </nav>
    <div class="nav-end">
      <a class="btn" href={SITE.smsHref}><span class="full">Text or call {SITE.phone}</span><span class="short">Text Devin</span></a>
      <button class="nav-toggle" type="button" aria-controls="nav-links" aria-expanded="false">Menu</button>
    </div>
  </div>
</header>
<script>
  const nav = document.querySelector<HTMLElement>('.nav')!;
  const btn = nav.querySelector<HTMLButtonElement>('.nav-toggle')!;
  const links = document.getElementById('nav-links')!;
  btn.addEventListener('click', () => {
    const open = links.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
    btn.textContent = open ? 'Close' : 'Menu';
  });
  links.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) { links.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); btn.textContent = 'Menu'; } });
  const onScroll = () => nav.classList.toggle('scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true }); onScroll();
</script>
